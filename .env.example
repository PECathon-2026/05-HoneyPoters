# PrivacyLens (PS-004) — Environment Configuration Template
# ============================================================

# 1. Google Gemini API Key
# Get a free key from Google AI Studio: https://aistudio.google.com/app/apikey
# Note: If left empty, PrivacyLens automatically runs in 100% Offline / Simulated Safe Mode!
VITE_GEMINI_API_KEY=

# 2. Target Gemini Model (Optional, defaults to gemini-1.5-flash)
VITE_GEMINI_MODEL=gemini-1.5-flash
