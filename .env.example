# PrivacyLens (PS-004) — Environment Variables
# Team 05-HoneyPoters — PECathon 2026

# Google Gemini API Key (Kept safe on server side, NEVER exposed to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Port (defaults to 3001)
PORT=3001

# Allowed CORS Origins (comma-separated or * for development)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Node Environment ('development' | 'production')
NODE_ENV=development
